APP_ENV=development
HTTP_PORT=8080
DATABASE_URL=postgres://postgres:password@localhost:5432/tibi?sslmode=disable
JWT_SECRET=replace-me-with-32-bytes-of-random
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
KASHIER_API_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
KASHIER_API_URL=https://api.kashier.io
KASHIER_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Storage. In dev, "local" is fine.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./data/files
STORAGE_LOCAL_BASE_URL=http://localhost:8080/files
STORAGE_LOCAL_SIGN_KEY=dev-sign-key-change-me

# Set these when STORAGE_DRIVER=s3
# S3_ENDPOINT=s3.amazonaws.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=medical-files
# S3_USE_SSL=true
# S3_REGION=eu-central-1
# S3_PUBLIC_URL=cdn.example.com