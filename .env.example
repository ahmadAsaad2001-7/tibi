# Copy to .env and adjust. Never commit real secrets in .env.

APP_ENV=development
HTTP_PORT=8080

# Local dev with docker compose (slice 18b) uses these postgres credentials.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medical?sslmode=disable

# Generate a real secret: openssl rand -base64 32
JWT_SECRET=replace-me-with-32-bytes-of-random
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Kashier payment provider (test mode).
KASHIER_API_KEY=replace-with-kashier-api-key
KASHIER_API_URL=https://api.kashier.io
KASHIER_WEBHOOK_SECRET=whsec_replace_me

# Storage. "local" for quick dev (files under ./data/files); "s3" for the
# Minio/R2-compatible dev stack (S3_USE_SSL=false, endpoint localhost:9000).
STORAGE_DRIVER=local
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=medical-files
S3_USE_SSL=false
S3_REGION=us-east-1
S3_PUBLIC_URL=

# Public base URL for password-reset / email-verification links.
APP_BASE_URL=http://localhost:3000

# Email. "logger" prints to stdout (dev); "smtp" sends through Mailhog in
# the local stack (port 1025).
EMAIL_DRIVER=logger
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@medical.local

# Rate limiting. "memory" for dev/single-instance, "postgres" for
# persistence and multi-instance.
RATE_LIMIT_DRIVER=memory

# Retention worker (slice 18e). Opt-in; the API binary ignores these.
RETENTION_ENABLED=false
RETENTION_CLINICAL_YEARS=7
RETENTION_BATCH_SIZE=1000
RETENTION_INTERVAL=24h